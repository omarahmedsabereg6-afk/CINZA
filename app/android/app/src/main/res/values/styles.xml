<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Themes tuned for CINZA.

        Two deliberate changes from the Capacitor default:

        1. The parent is forced to a dark AppCompat theme. The generated default is
           DayNight, which follows the system setting — so on a phone in light mode
           the activity window is LIGHT behind the webview, producing a white flash
           on launch and on every transition before the dark web layer paints.

        2. android:windowBackground is set explicitly. The webview is transparent
           until the bundle paints its first frame, and the window background is
           what shows through in that gap.
    -->

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/cinzaBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/cinzaBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/cinzaBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/cinzaBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/cinzaSplashBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>
</resources>