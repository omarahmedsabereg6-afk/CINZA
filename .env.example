# ============================================================
# CINZA — environment template
# Copy to `.env` (project root) and fill in. NEVER commit `.env`.
# Every value here is server-side only. None of it is ever sent to the app.
# ============================================================

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Public URL of the backend. Used for links returned to the app.
API_URL=http://localhost:8787

# ------------------------------------------------------------
# Database
#
# Both Prisma schemas (prisma/schema.prisma = postgresql and the generated
# prisma/schema.dev.prisma = sqlite) read this ONE variable, so switching
# environments is a one-line change here.
#
#   Local dev, no server needed (default):  file:./dev.db
#   Production:                             postgresql://user:pass@host:5432/cinza
#
# The SQLite path is resolved relative to prisma/. After changing this value run
# the matching generate + push:
#   sqlite     -> npm run db:dev:generate && npm run db:dev:push
#   postgresql -> npm run db:generate     && npm run db:migrate:dev
# ------------------------------------------------------------
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgresql://cinza:cinza@localhost:5432/cinza?schema=public

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ------------------------------------------------------------
# AI vision (server-side only)
# ------------------------------------------------------------
# Provider: mock | openai | gemini
# Keep OPENAI_API_KEY for the existing OpenAI flow. Set AI_PROVIDER=gemini and
# GEMINI_API_KEY to use Google Gemini instead. Without a live key, CINZA safely
# falls back to the mock vision adapter and marks results as simulated.
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_MODEL=gpt-5.6-terra
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=45000
AI_MAX_IMAGE_EDGE=1024
# Trigger the second-stage fallback only when the primary AI confidence is below this threshold.
RECOGNITION_FALLBACK_THRESHOLD=0.70
# Hard cap per recognition (cost control, section 41)
AI_MAX_CALLS_PER_RECOGNITION=2

# ------------------------------------------------------------
# TMDB  (https://www.themoviedb.org/settings/api)
# ------------------------------------------------------------
# Provider: mock | tmdb
TMDB_PROVIDER=mock
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=en-US
TMDB_CACHE_TTL_MS=86400000

# ------------------------------------------------------------
# Streaming availability (section 17 + 19)
# ------------------------------------------------------------
# Provider: mock | tmdb
STREAMING_PROVIDER=mock
STREAMING_API_KEY=
STREAMING_DEFAULT_REGION=US

# ------------------------------------------------------------
# External ratings — Rotten Tomatoes official API/Data Feed
# ------------------------------------------------------------
# Preparation only. Do not enable until official Rotten Tomatoes API/Data Feed
# authorization, credentials, attribution rules, and endpoint documentation are
# approved. CINZA must never use scraping or undocumented Rotten Tomatoes endpoints.
ROTTEN_TOMATOES_ENABLED=false
ROTTEN_TOMATOES_API_KEY=
ROTTEN_TOMATOES_BASE_URL=
ROTTEN_TOMATOES_TIMEOUT_MS=4500
ROTTEN_TOMATOES_CACHE_TTL_MS=86400000

# ------------------------------------------------------------
# Uploads / limits (section 9, 10, 30)
# ------------------------------------------------------------
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=52428800
MAX_VIDEO_DURATION_SECONDS=120
MAX_VIDEO_FRAMES=6
MAX_IMAGE_DIMENSION=6000
MIN_IMAGE_DIMENSION=120
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ------------------------------------------------------------
# Security / hardening (section 28)
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:8787,http://localhost:5173,capacitor://localhost,https://localhost,http://localhost
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RECOGNITION_RATE_LIMIT_MAX=20
TRUST_PROXY=0

# ------------------------------------------------------------
# Dev helpers
# ------------------------------------------------------------
# Serve /app from the API process so the whole app runs on one origin in dev.
SERVE_APP=true
LOG_LEVEL=info
